#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <math.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, ".UTF8");
    float x, y;

    printf("Введите координаты точки (x, y): ");
    scanf("%f %f", &x, &y);

    // Уточненные условия границ трапеции:
    // Левая линия: 2*x - y + 9 >= 0
    // Правая линия: 2*x + y - 13 <= 0
    if (y >= 1 && y <= 5 && (2 * x - y + 9 >= 0) && (2 * x + y - 13 <= 0)) {
        printf("Точка ПРИНАДЛЕЖИТ области.\n");
    }
    else {
        printf("Точка НЕ ПРИНАДЛЕЖИТ области.\n");
    }

    return 0;
}

//Контрольный пример :
// Точка(0, 2) — находится внутри области(выведет : ПРИНАДЛЕЖИТ области.)
// Точка(-4, 1) — левый нижний угол(выведет : ПРИНАДЛЕЖИТ области.).
// Точка(0, 0) — находится ниже фигуры(выведет : НЕ ПРИНАДЛЕЖИТ области.).









